        "# Step 3: Prepare the dataset for machine learning\n",
        "\n",
        "# Remove extra spaces from column names\n",
        "df.columns = df.columns.str.strip()\n",
        "\n",
        "# Clean text values and replace missing-value markers\n",
        "for col in df.select_dtypes(include=\"object\").columns:\n",
        "    df[col] = df[col].str.strip()\n",
        "    df[col] = df[col].replace({\"?\": np.nan, \"\": np.nan})\n",
        "\n",
        "# Separate input features and target\n",
        "X = df.drop(columns=[\"class\"])\n",
        "y = df[\"class\"].astype(str).str.strip().str.lower()\n",
        "\n",
        "# Remove rows where the target is missing\n",
        "valid_rows = y.isin([\"ckd\", \"notckd\"])\n",
        "X = X.loc[valid_rows].copy()\n",
        "y = y.loc[valid_rows].copy()\n",
        "\n",
        "# Convert target labels into numbers\n",
        "y = y.map({\"ckd\": 1, \"notckd\": 0})\n",
        "\n",
        "print(\"Data preparation completed!\")\n",
        "print(\"\\nNumber of usable records:\", len(X))\n",
        "print(\"\\nTarget class distribution:\")\n",
        "print(y.map({1: \"CKD\", 0: \"No CKD\"}).value_counts())\n",
        "print(\"\\nMissing values in inputs:\", int(X.isna().sum().sum()))"
